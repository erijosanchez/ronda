includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app
        - src
        - config
        - database
        - routes

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor

    # checkMissingIterableValueType y checkGenericClassInNonGenericObjectType
    # desaparecieron en PHPStan 2.x: van implicitas desde el nivel 6.
    #
    # Sin baseline. Un baseline que crece es deuda disfrazada de proceso, y la
    # CI tiene una puerta que falla si alguien lo introduce.
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true

    ignoreErrors: []
