<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <!-- Pruebas que necesitan bases de datos de verdad: la provision de un
             tenant hace CREATE DATABASE, y PostgreSQL no lo permite dentro de
             la transaccion en la que RefreshDatabase envuelve cada prueba. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Los modulos guardan sus pruebas en src/<Modulo>/Tests (CLAUDE.md).
             Sin esta entrada nunca se ejecutaban. -->
        <testsuite name="Modules">
            <directory>src/*/Tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <!-- El codigo de negocio vive en src/. Medir cobertura solo sobre
                 app/ daba un porcentaje que no hablaba de nada. -->
            <directory>app</directory>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/*/Database/Migrations</directory>
            <directory>src/*/Tests</directory>
        </exclude>
    </source>
    <php>
        <!-- force="true" NO es opcional aqui.

             docker-compose inyecta .env en el contenedor con `env_file`, asi
             que APP_ENV, DB_DATABASE y QUEUE_CONNECTION ya existen como
             variables de entorno del proceso. Sin `force`, PHPUnit respeta
             las que ya estan definidas y estas se ignoran en silencio: la
             suite corria contra `ronda_central` (la base de desarrollo) con
             la cola de redis, y un test con DatabaseMigrations la borraba.

             Si alguien quita estos `force`, las pruebas vuelven a apuntar a
             la base de desarrollo sin avisar. Hay un test que lo verifica:
             tests/Feature/Security/TestEnvironmentTest.php -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="ronda_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>
        <!-- La comprobacion contra filtraciones conocidas (Password::uncompromised)
             sale a Internet en cada validacion de contrasena. En produccion es
             obligatoria; en las pruebas la apaga para que no dependan de la red
             ni tarden un viaje de ida y vuelta por cada alta. -->
        <env name="PASSWORD_CHECK_COMPROMISED" value="false" force="true"/>


        <!-- Las mismas claves como <server>. PHP en CLI copia el entorno
             del proceso a $_SERVER, y el lector de Dotenv que usa env() en
             Laravel consulta $_SERVER ANTES que $_ENV. force="true" en <env>
             solo toca getenv() y $_ENV, asi que sin estas entradas $_SERVER
             conservaba APP_ENV=local y DB_DATABASE=ronda_central y ganaba. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="ronda_testing" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="DB_HOST" value="postgres" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="FILESYSTEM_DISK" value="local" force="true"/>
        <server name="PASSWORD_CHECK_COMPROMISED" value="false" force="true"/>
    </php>
</phpunit>
