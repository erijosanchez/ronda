###> Aplicacion ###
APP_NAME=Ronda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Dominio central del SaaS. Los tenants viven en subdominios de este.
CENTRAL_DOMAIN=localhost

###> Octane / FrankenPHP ###
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

###> Base de datos (central) ###
# Dentro de docker: host=postgres puerto=5432. Desde el host: localhost:5433.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ronda_central
DB_USERNAME=ronda
DB_PASSWORD=secret

# Prefijo de las bases de tenant: ronda_tnt_<ulid>
TENANT_DB_PREFIX=ronda_tnt_
TENANT_DB_SUFFIX=

###> Redis ###
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379
# Bases logicas separadas por funcion (sec. 5.1)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

###> Caches, colas y sesion ###
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true solo con HTTPS real. Ver docs/DEPLOYMENT.md
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

###> Broadcasting (Reverb) ###
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ronda
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

###> Almacenamiento de evidencia (S3 privado: MinIO en local, R2 en produccion) ###
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=ronda
AWS_SECRET_ACCESS_KEY=secretsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ronda-evidence
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Vida de la URL firmada de evidencia, en minutos (sec. 10.4)
EVIDENCE_SIGNED_URL_TTL=5

###> Correo ###
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@ronda.pe"
MAIL_FROM_NAME="${APP_NAME}"

###> Seguridad ###
# Roles que exigen 2FA obligatorio (sec. 10.2)
TWO_FACTOR_ENFORCED_ROLES=owner,admin,finance
PASSWORD_MIN_LENGTH=12
PASSWORD_CHECK_COMPROMISED=true
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

###> Observabilidad ###
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

###> Integraciones (fases posteriores) ###
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
